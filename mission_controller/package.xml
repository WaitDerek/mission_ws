<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mission_controller</name>
  <version>0.1.0</version>
  <description>RealBot box-grasp and box-place mission orchestration.</description>
  <maintainer email="dekc@example.com">dekc</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>action_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>rm_robot_interfaces</depend>
  <depend>mission_interfaces</depend>
  <depend>object_pose_interfaces</depend>
  <depend>task_interfaces</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>object_pose_ros</exec_depend>
  <exec_depend>robot_bringup</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
