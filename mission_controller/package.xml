<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mission_controller</name>
  <version>0.1.0</version>
  <description>G1-D badge tracking mission controller.</description>
  <maintainer email="dekc@example.com">dekc</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>action_msgs</depend>
  <depend>ament_index_python</depend>
  <depend>brsd_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>object_pose_interfaces</depend>
  <depend>visualization_msgs</depend>
  <depend>mission_interfaces</depend>
  <depend>task_interfaces</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>robot_bringup</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
