# Execute one complete box-stacking cycle for a configured level.
# level must be an integer in [1, 4]. Both arms remain at one fixed highest
# loading posture; the selected level maps to a configured 4-joint torso state.
# Speeds, timing, gripper commands, and recovery behaviour are owned by Mission.
int32 level

---

bool success
string message
int32 level
float64[4] target_torso_positions
string arm_message
bool gripper_closed
bool gripper_opened
bool retreat_completed
bool ready_completed

---

# stage is one of: INITIALIZING, PREPARING_START_POSE, CLOSING_GRIPPERS,
# LOWERING_TORSO, WAITING_TO_RELEASE, OPENING_GRIPPERS, RETREATING,
# RETURNING_READY, DONE,
# FAILED, or CANCELLED.
string stage
string detail
int32 level
