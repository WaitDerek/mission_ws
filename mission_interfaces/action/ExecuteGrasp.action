# Execute the G1-D badge tracking sequence.
# Legacy goal fields remain for command-line compatibility; G1-D always uses
# the left arm and the configured badge model.
string request_id
int32 target_label
string arm
bool publish_pose
float64 detection_timeout_sec
bool dry_run

