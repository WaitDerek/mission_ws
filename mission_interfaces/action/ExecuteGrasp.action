bool success
string message
geometry_msgs/PoseStamped grasp_pose
float64 score
float64 width
float64 height
float64 depth
int32 object_id
string arm
string arm_message
bool gripper_command_published
bool torso_reset_command_published

---

string stage
string detail
string arm
